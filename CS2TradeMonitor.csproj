<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>resources\assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>CS2TradeMonitor</AssemblyName>
    <RootNamespace>CS2TradeMonitor</RootNamespace>
    <Title>CS2 Trade Monitor</Title>
    <Product>CS2 Trade Monitor / CS2交易监控</Product>
    <Description>CS2 Trade Monitor / CS2交易监控</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <DebugType Condition="'$(CoverageBuild)' != 'true'">none</DebugType>
    <DebugSymbols Condition="'$(CoverageBuild)' != 'true'">false</DebugSymbols>
    <DebugType Condition="'$(CoverageBuild)' == 'true'">portable</DebugType>
    <DebugSymbols Condition="'$(CoverageBuild)' == 'true'">true</DebugSymbols>

    <Version>1.38</Version><!-- 发布版本的唯一来源；程序集与文件版本由 SDK 派生。 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Custom controls are composed entirely in code and are not serialized by the WinForms designer. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <!-- 自动复制 lang 与图文指引资源 -->
  <ItemGroup>
    <ProjectReference Include="CS2MarketData.Core\CS2MarketData.Core.csproj" />
    <ProjectReference Include="CS2TradeMonitor.Shared.csproj" />
    <ProjectReference Include="CS2TradeMonitor.YouPinPrivacyAudit\CS2TradeMonitor.YouPinPrivacyAudit.csproj" />

    <Content Include="resources\lang\*.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>

    <Content Include="resources\api-help\*.png" Condition="Exists('resources\api-help')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>

    <Content Include="resources\steamdt_items.json.gz" Condition="Exists('resources\steamdt_items.json.gz')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>

    <Content Include="resources\author-note.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="使用说明(必读).txt">
      <TargetPath>使用说明(必读).txt</TargetPath>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>

    <Content Include="THIRD_PARTY_NOTICES.txt">
      <TargetPath>docs\THIRD_PARTY_NOTICES.txt</TargetPath>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

